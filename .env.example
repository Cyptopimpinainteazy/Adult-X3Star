# ── Server ────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Behind nginx/Caddy/Cloudflare? Set both:
TRUST_PROXY=1
COOKIE_SECURE=1
SESSION_DAYS=30

# ── Storage (SQLite database + uploads live here — back it up) ──
DATA_DIR=./data
MAX_UPLOAD_MB=50
# Uploads stay private until an admin approves them (recommended: 0)
AUTO_APPROVE_UPLOADS=0

# ── First admin (created on first start if no admin exists) ──
ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=change-me-to-something-long

# ── Demo content ──────────────────────────────────────────
# 1 = seed 16 demo creators, fans, gift history and families on an empty DB
SEED_DEMO=1
DEMO_PASSWORD=
# 1 = server generates simulated chat / gifts / entrances so rooms feel alive
DEMO_TRAFFIC=1

# ── Payments ─────────────────────────────────────────────
# test     = diamond purchases credit instantly, no charge (orders flagged test)
# disabled = purchase endpoint returns 503
PAYMENTS_MODE=test

# ── Affiliate click hashing salt (any random string) ─────
CLICK_SALT=
